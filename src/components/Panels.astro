---
// Panneaux HUD (Parcours / Projets / Contact) + contrôleur de navigation.
import site from '../data/site.json';
import projects from '../data/projects.json';
import parcours from '../data/parcours.json';

const orderedProjects = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));

// --- Projets : utilitaires d'affichage -------------------------------------
// Aucun de ces champs n'est obligatoire : si la donnée manque, le bloc disparaît.
const slug = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Familles de technos : sert à colorer les étiquettes sans toucher au JSON.
const TECH_KIND: Record<string, string> = {
  HTML: 'lang',
  CSS: 'lang',
  SCSS: 'lang',
  JS: 'lang',
  JavaScript: 'lang',
  TypeScript: 'lang',
  PHP: 'lang',
  Java: 'lang',
  Rust: 'lang',
  Python: 'lang',
  C: 'lang',
  SQL: 'lang',
  MDX: 'lang',
  'three.js': 'lib',
  React: 'lib',
  'Next.js': 'lib',
  Astro: 'lib',
  Symfony: 'lib',
  'Spring Boot': 'lib',
  Twig: 'lib',
  MySQL: 'db',
  PostgreSQL: 'db',
  SQLite: 'db',
  Docker: 'tool',
  Git: 'tool',
  Postman: 'tool',
  Vite: 'tool',
  Linux: 'tool',
};
const techKind = (name: string) => TECH_KIND[name] ?? 'tool';

const MONTHS = [
  'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre',
];
const formatMonth = (value?: string) => {
  if (!value) return '';
  const [year, month] = value.split('-');
  return month ? `${MONTHS[Number(month) - 1]} ${year}` : year;
};
const formatPeriod = (period?: { start?: string; end?: string }) => {
  if (!period) return '';
  const start = formatMonth(period.start);
  const end = period.end ? formatMonth(period.end) : 'en cours';
  return start ? `${start} → ${end}` : end;
};

const contacts: { label: string; value: string; href: string; external: boolean }[] = [];
if (site.email) {
  contacts.push({ label: 'Email', value: site.email, href: `mailto:${site.email}`, external: false });
}
if (site.github) {
  contacts.push({
    label: 'GitHub',
    value: site.github.replace(/^https?:\/\//, ''),
    href: site.github,
    external: true,
  });
}
if (site.linkedin) {
  contacts.push({
    label: 'LinkedIn',
    value: site.linkedin.replace(/^https?:\/\//, ''),
    href: site.linkedin,
    external: true,
  });
}
---

<section class="panel" id="parcours" data-panel="parcours" aria-labelledby="parcours-title" tabindex="-1" inert>
  <header class="panel-head">
    <p class="panel-index"><span>01</span>Parcours</p>
    <button class="panel-close" type="button" data-close aria-label="Fermer le panneau">
      Fermer <kbd>Esc</kbd>
    </button>
  </header>
  <div class="panel-body">
    <h2 class="panel-title" id="parcours-title" data-r>Le chemin parcouru</h2>

    <div class="about" data-r style="--i: 1">
      <p class="label">À propos</p>
      <p class="lede">{site.bio}</p>
    </div>

    <ol class="trace">
      {
        parcours.map((etape, i) => (
          <li data-r style={`--i: ${i + 2}`}>
            <span class="pt" aria-hidden="true" />
            <span class="year">{etape.year}</span>
            <h3>{etape.title}</h3>
            <p>{etape.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="panel" id="projets" data-panel="projets" aria-labelledby="projets-title" tabindex="-1" inert>
  <header class="panel-head">
    <p class="panel-index"><span>02</span>Projets</p>
    <button class="panel-close" type="button" data-close aria-label="Fermer le panneau">
      Fermer <kbd>Esc</kbd>
    </button>
  </header>
  <div class="panel-body">
    <h2 class="panel-title" id="projets-title" data-r>Ce que je construis</h2>

    <ul class="orbits" data-projects-list>
      {
        (orderedProjects as any[]).map((project, i) => {
          const meta = [
            project.period ? { k: 'Période', v: formatPeriod(project.period) } : null,
            project.category ? { k: 'Catégorie', v: project.category } : null,
            project.role ? { k: 'Rôle', v: project.role } : null,
            project.status ? { k: 'Statut', v: project.status } : null,
          ].filter(Boolean) as { k: string; v: string }[];

          return (
            <li data-r style={`--i: ${i + 1}`}>
              <div class="orbit" aria-hidden="true">
                <svg viewBox="0 0 64 64">
                  <ellipse class="ring" cx="32" cy="32" rx="26" ry="10" />
                  <circle class="core" cx="32" cy="32" r="3.5" />
                </svg>
                <span class="sat" />
              </div>
              <div class="orbit-body">
                {project.featured && <p class="label">En avant</p>}
                <h3>{project.title}</h3>

                {meta.length > 0 && (
                  <dl class="meta">
                    {meta.map((m) => (
                      <>
                        <dt>{m.k}</dt>
                        <dd>{m.v}</dd>
                      </>
                    ))}
                  </dl>
                )}

                {project.image && (
                  <img
                    src={`${import.meta.env.BASE_URL}${project.image.replace(/^\/+/, '')}`}
                    alt={`Aperçu du projet ${project.title}`}
                    loading="lazy"
                  />
                )}
                <p class="desc">{project.description}</p>
                <ul class="tags">
                  {project.technologies.map((tech: string) => (
                    <li class={`tag tag--${techKind(tech)}`}>{tech}</li>
                  ))}
                </ul>
                <div class="actions">
                  {project.url && (
                    <a href={project.url} target="_blank" rel="noopener noreferrer">
                      Code source <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noopener noreferrer">
                      Voir la démo <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.case && (
                    <button class="case-open" type="button" data-case={slug(project.title)}>
                      Lire l’étude de cas <span aria-hidden="true">↳</span>
                    </button>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      (orderedProjects as any[])
        .filter((project) => project.case)
        .map((project) => {
          const c = project.case;
          const blocks = [
            { k: 'Contexte', v: c.context },
            { k: 'Démarche', v: c.process },
            { k: 'Ce dont je suis fier', v: c.pride },
            { k: 'Difficultés', v: c.difficulty },
            { k: 'À refaire', v: c.again },
            { k: 'Ce que j’ai appris', v: c.learned },
          ].filter((b) => b.v) as { k: string; v: string }[];

          return (
            <article class="case" data-case-panel={slug(project.title)} hidden>
              <button class="case-back" type="button" data-case-back>
                <span aria-hidden="true">←</span> Retour aux projets
              </button>

              {project.category && <p class="label">{project.category}</p>}
              <h3>{project.title}</h3>

              <dl class="meta">
                {project.period && (
                  <>
                    <dt>Période</dt>
                    <dd>{formatPeriod(project.period)}</dd>
                  </>
                )}
                {project.role && (
                  <>
                    <dt>Rôle</dt>
                    <dd>{project.role}</dd>
                  </>
                )}
                {project.status && (
                  <>
                    <dt>Statut</dt>
                    <dd>{project.status}</dd>
                  </>
                )}
              </dl>

              {blocks.map((b) => (
                <section class="case-block">
                  <h4>{b.k}</h4>
                  <p>{b.v}</p>
                </section>
              ))}

              <div class="actions">
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer">
                    Code source <span aria-hidden="true">↗</span>
                  </a>
                )}
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener noreferrer">
                    Voir la démo <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          );
        })
    }
  </div>
</section>

<section class="panel" id="contact" data-panel="contact" aria-labelledby="contact-title" tabindex="-1" inert>
  <header class="panel-head">
    <p class="panel-index"><span>03</span>Contact</p>
    <button class="panel-close" type="button" data-close aria-label="Fermer le panneau">
      Fermer <kbd>Esc</kbd>
    </button>
  </header>
  <div class="panel-body">
    <h2 class="panel-title big" id="contact-title" data-r>Construisons quelque chose.</h2>

    <ul class="links">
      {
        contacts.map((c, i) => (
          <li data-r style={`--i: ${i + 1}`}>
            <a
              class="row"
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
            >
              <span class="k">{c.label}</span>
              <span class="v">{c.value}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="cv" data-r style="--i: 4" aria-labelledby="cv-title">
      <p class="label" id="cv-title">Curriculum vitae</p>
      <p class="cv-note">Version claire, recommandée pour l’impression et la lecture.</p>
      <div class="cv-actions">
        <a href={`${import.meta.env.BASE_URL}documents/cv-light.pdf`} target="_blank" rel="noopener noreferrer">
          Consulter le CV <span aria-hidden="true">↗</span>
        </a>
        <a href={`${import.meta.env.BASE_URL}documents/cv-light.pdf`} download="CV-Alexandre-Grandjean.pdf">
          Télécharger le CV <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a class="cv-dark" href={`${import.meta.env.BASE_URL}documents/cv-dark.pdf`} target="_blank" rel="noopener noreferrer">
        Consulter la version sombre <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- Coque du panneau ---------- */
  .panel {
    position: fixed;
    top: calc(var(--frame) + 3.6rem);
    right: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 1.6rem);
    width: min(34rem, calc(100vw - 2 * (var(--frame) + 1.6rem)));
    z-index: 4;
    display: flex;
    flex-direction: column;
    background: rgba(3, 4, 9, 0.74);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    opacity: 0;
    visibility: hidden;
    transform: translateX(28px);
    transition:
      opacity 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s linear 0.5s;
  }

  .panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.6s ease 0.45s,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.45s,
      visibility 0s;
  }

  .panel:focus {
    outline: none;
  }

  .panel::before,
  .panel::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--accent);
    pointer-events: none;
  }
  .panel::before {
    top: -1px;
    left: -1px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .panel::after {
    right: -1px;
    bottom: -1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }

  .panel-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.4rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .panel-index {
    color: var(--text);
  }
  .panel-index span {
    color: var(--muted);
    margin-right: 0.8em;
  }

  .panel-close {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0.3rem 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .panel-close:hover,
  .panel-close:focus-visible {
    color: var(--accent);
  }
  .panel-close kbd {
    font: inherit;
    margin-left: 0.5em;
    padding: 0.05em 0.5em;
    border: 1px solid var(--line);
    letter-spacing: 0.08em;
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.8rem 1.4rem 2.4rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .panel-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1.05;
    margin-bottom: 1.8rem;
  }
  .panel-title.big {
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    margin-bottom: 2.4rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  /* ---------- Révélation échelonnée ---------- */
  [data-r] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .panel.is-open [data-r] {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s ease calc(0.6s + var(--i, 0) * 0.09s),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(0.6s + var(--i, 0) * 0.09s);
  }

  /* ---------- Parcours : trajectoire de points reliés ---------- */
  .about {
    margin-bottom: 2.4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .lede {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 46ch;
  }

  .trace {
    list-style: none;
  }
  .trace li {
    position: relative;
    padding: 0 0 2.2rem 2rem;
  }
  .trace li:last-child {
    padding-bottom: 0;
  }

  .pt {
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text);
    box-shadow: 0 0 12px 1px rgba(159, 196, 240, 0.55);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .trace li:hover .pt {
    transform: scale(1.5);
    box-shadow: 0 0 18px 3px rgba(159, 196, 240, 0.8);
  }

  .trace li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 3px;
    top: calc(0.5rem + 3.5px);
    height: 100%;
    width: 1px;
    background: linear-gradient(to bottom, rgba(159, 196, 240, 0.55), rgba(159, 196, 240, 0.12));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s ease;
  }
  .panel.is-open .trace li:not(:last-child)::after {
    transform: scaleY(1);
    transition: transform 0.9s ease calc(0.8s + var(--i, 0) * 0.22s);
  }

  .year {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .trace h3,
  .orbit-body h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.15;
    margin-bottom: 0.35rem;
  }
  .trace p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* ---------- Projets : corps en orbite ---------- */
  .orbits {
    list-style: none;
  }
  .orbits > li {
    display: flex;
    gap: 1.2rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .orbits > li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .orbit {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
    transform: rotate(-24deg);
  }
  .orbit svg {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    transition: stroke 0.3s ease;
  }
  .core {
    fill: var(--text);
    filter: drop-shadow(0 0 5px rgba(159, 196, 240, 0.8));
  }
  .orbits > li:hover .ring {
    stroke: var(--accent);
  }
  .sat {
    display: none;
  }
  @supports (offset-path: path('M 0 0')) {
    .sat {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
      offset-path: path('M 6 32 a 26 10 0 1 0 52 0 a 26 10 0 1 0 -52 0');
      offset-distance: 0%;
      animation: orbit calc(5s + var(--i, 1) * 1.8s) linear infinite;
    }
  }
  @keyframes orbit {
    to {
      offset-distance: 100%;
    }
  }

  .orbit-body {
    min-width: 0;
  }
  .orbit-body img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    margin: 0.7rem 0;
  }
  .desc {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 0.15rem 0.55rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .actions a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .actions a:hover,
  .actions a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- Projets : métadonnées, étiquettes, étude de cas ---------- */
  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
    margin: 0.7rem 0 1rem;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.18rem;
  }
  .meta dd {
    font-size: 0.84rem;
    color: var(--text);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .tag::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex: none;
  }
  .tag--lang::before {
    background: var(--text);
  }
  .tag--lib::before {
    background: var(--accent);
    box-shadow: 0 0 6px rgba(159, 196, 240, 0.85);
  }
  .tag--db::before {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .tag--tool::before {
    background: var(--muted);
  }

  .actions button {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .actions button:hover,
  .actions button:focus-visible {
    color: var(--text);
    border-color: var(--accent);
  }

  .case[hidden] {
    display: none;
  }
  .case-back {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: none;
    border: 0;
    padding: 0.35rem 0;
    margin-bottom: 1.6rem;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .case-back:hover,
  .case-back:focus-visible {
    color: var(--accent);
  }
  .case h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 1.1;
    margin: 0.2rem 0 0.9rem;
  }
  .case-block {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .case-block h4 {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.45rem;
  }
  .case-block p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* ---------- Contact ---------- */
  .links {
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .cv {
    margin-top: 2rem;
  }
  .cv-note {
    color: var(--muted);
    font-size: 0.88rem;
    margin-bottom: 1rem;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
  }
  .cv-actions a,
  .cv-dark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .cv-actions a:hover,
  .cv-actions a:focus-visible,
  .cv-dark:hover,
  .cv-dark:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cv-dark {
    color: var(--muted);
    margin-top: 0.6rem;
    font-size: 0.66rem;
  }
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0.6rem;
    margin-inline: -0.6rem;
    border-top: 1px solid var(--line);
    transition: background 0.25s ease;
  }
  .row .k {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .row .v {
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  .row .arrow {
    font-family: var(--font-mono);
    color: var(--muted);
    transition: transform 0.25s ease, color 0.2s ease;
  }
  .row:hover,
  .row:focus-visible {
    background: rgba(159, 196, 240, 0.05);
  }
  .row:hover .v,
  .row:focus-visible .v,
  .row:hover .arrow,
  .row:focus-visible .arrow {
    color: var(--accent);
  }
  .row:hover .arrow,
  .row:focus-visible .arrow {
    transform: translate(3px, -3px);
  }

  /* ---------- Mobile : panneau en bas ---------- */
  @media (max-width: 800px) {
    .panel {
      top: 47svh;
      left: calc(var(--frame) + 0.4rem);
      right: calc(var(--frame) + 0.4rem);
      bottom: max(var(--frame), env(safe-area-inset-bottom));
      width: auto;
      transform: translateY(28px);
    }
    .panel-body {
      padding: 1.4rem 1.1rem 2rem;
    }
    .row {
      grid-template-columns: 4.5rem 1fr auto;
      min-height: 48px;
    }
    .panel-close {
      min-height: 44px;
      padding-inline: 0.35rem;
    }
  }

  @media (max-width: 800px) and (max-height: 500px) {
    .panel {
      top: calc(var(--frame) + 3.2rem);
      left: auto;
      right: calc(var(--frame) + 0.4rem);
      bottom: max(var(--frame), env(safe-area-inset-bottom));
      width: min(48vw, 26rem);
      transform: translateX(28px);
    }
    .panel-body {
      padding: 1rem;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const ids = panels.map((p) => p.dataset.panel as string);

  let current: string | null = null;
  let lastTrigger: HTMLElement | null = null;

  // --- Projets : bascule liste ⇄ étude de cas ---
  const projectsList = document.querySelector<HTMLElement>('[data-projects-list]');
  const cases = Array.from(document.querySelectorAll<HTMLElement>('[data-case-panel]'));

  function showCase(id: string | null) {
    if (!projectsList) return;
    const target = id ? cases.find((c) => c.dataset.casePanel === id) ?? null : null;
    projectsList.hidden = target !== null;
    cases.forEach((c) => {
      c.hidden = c !== target;
    });
    const body = document.querySelector<HTMLElement>('[data-panel="projets"] .panel-body');
    if (body) body.scrollTop = 0;
  }

  function apply(id: string | null, focusPanel = false) {
    if (id === current) return;
    current = id;

    if (id) root.dataset.view = id;
    else delete root.dataset.view;

    panels.forEach((panel) => {
      const open = panel.dataset.panel === id;
      panel.classList.toggle('is-open', open);
      panel.toggleAttribute('inert', !open);
      if (open && focusPanel) panel.focus({ preventScroll: true });
    });

    document.querySelectorAll<HTMLElement>('[data-node]').forEach((el) => {
      const isCurrent = el.dataset.node === id;
      el.classList.toggle('is-current', isCurrent);
      if (isCurrent) el.setAttribute('aria-current', 'true');
      else el.removeAttribute('aria-current');
    });

    panels.forEach((panel) => {
      if (panel.dataset.panel === id) {
        const body = panel.querySelector<HTMLElement>('.panel-body');
        if (body) body.scrollTop = 0;
      }
    });

    if (id !== 'projets') showCase(null);

    window.dispatchEvent(new CustomEvent('viewchange', { detail: id }));
  }

  function open(id: string, trigger: HTMLElement | null) {
    lastTrigger = trigger;
    if (location.hash !== `#${id}`) history.pushState(null, '', `#${id}`);
    apply(id, trigger !== null);
  }

  function close(restoreFocus: boolean) {
    if (!current) return;
    history.pushState(null, '', location.pathname + location.search);
    apply(null);
    if (restoreFocus) lastTrigger?.focus({ preventScroll: true });
  }

  function sync() {
    const raw = location.hash.slice(1);
    if (raw.startsWith('projets/')) {
      apply('projets');
      showCase(raw.slice('projets/'.length));
      return;
    }
    apply(ids.includes(raw) ? raw : null);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const link = target.closest<HTMLElement>('a[data-node]');
    if (link) {
      event.preventDefault();
      const viaKeyboard = event.detail === 0;
      open(link.dataset.node as string, viaKeyboard ? link : null);
      return;
    }
    if (target.closest('[data-close]')) {
      close(event.detail === 0);
      return;
    }
    const caseButton = target.closest<HTMLElement>('[data-case]');
    if (caseButton?.dataset.case) {
      showCase(caseButton.dataset.case);
      return;
    }
    if (target.closest('[data-case-back]')) {
      showCase(null);
      return;
    }
    if (current && target.closest('#galaxy')) close(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    if (event.key === 'Escape') {
      close(true);
      return;
    }
    const id = ids[Number(event.key) - 1];
    if (!id) return;
    if (id === current) close(true);
    else open(id, document.activeElement as HTMLElement | null);
  });

  window.addEventListener('hashchange', sync);
  window.addEventListener('popstate', sync);
  sync();
</script>
