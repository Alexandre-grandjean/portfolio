---
// Cadre HUD : repères de coin, menu, identité, indications.
import site from '../data/site.json';

const links = [
  { id: 'parcours', label: 'Parcours' },
  { id: 'projets', label: 'Projets' },
  { id: 'contact', label: 'Contact' },
];
---

<div class="hud">
  <span class="corner tl" aria-hidden="true"></span>
  <span class="corner tr" aria-hidden="true"></span>
  <span class="corner bl" aria-hidden="true"></span>
  <span class="corner br" aria-hidden="true"></span>

  <header class="top">
    <p class="mark">Portfolio <span>—</span> {new Date().getFullYear()}</p>
    <nav aria-label="Navigation principale">
      {links.map((l) => <a href={`#${l.id}`} data-node={l.id}>{l.label}</a>)}
    </nav>
  </header>

  <div class="idle">
    <div class="identity">
      <p class="role">{site.role}</p>
      <h1 class="name">{site.name}</h1>
    </div>

    <p class="hint" aria-hidden="true">Clique un astre pour voyager</p>
    <p class="readout" aria-hidden="true">
      X <span data-readout-x>0.00</span> &nbsp; Y <span data-readout-y>0.00</span>
    </p>
  </div>
</div>

<style>
  .hud {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hud::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(3, 4, 9, 0.92) 0%, rgba(3, 4, 9, 0.55) 45%, transparent 100%);
    z-index: -1;
    transition: opacity 0.8s ease;
  }

  :global(html[data-view]) .hud::before {
    opacity: 0;
  }

  .idle {
    position: absolute;
    inset: 0;
    transition: opacity 0.6s ease;
  }

  :global(html[data-view]) .idle {
    opacity: 0;
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--line);
    border-style: solid;
    border-width: 0;
    opacity: 0;
    animation: hud-in 1.2s ease 0.4s forwards;
  }
  .tl { top: var(--frame); left: var(--frame); border-top-width: 1px; border-left-width: 1px; }
  .tr { top: var(--frame); right: var(--frame); border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: var(--frame); left: var(--frame); border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: var(--frame); right: var(--frame); border-bottom-width: 1px; border-right-width: 1px; }

  .top {
    position: absolute;
    top: calc(var(--frame) + 0.9rem);
    left: calc(var(--frame) + 1.6rem);
    right: calc(var(--frame) + 1.6rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    opacity: 0;
    animation: hud-in 1.2s ease 0.8s forwards;
  }

  .mark {
    color: var(--muted);
  }
  .mark span {
    margin: 0 0.4em;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.2rem);
    pointer-events: auto;
  }

  nav a {
    color: var(--text);
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .identity {
    position: absolute;
    left: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 1.4rem);
    max-width: min(40rem, 70vw);
    opacity: 0;
    transform: translateY(14px);
    animation: hud-rise 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 1.2s forwards;
  }

  .role {
    color: var(--muted);
    margin-bottom: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: none;
    font-size: 0.78rem;
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 6.4vw, 5.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text);
  }

  .hint {
    position: absolute;
    right: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 1.4rem);
    color: var(--muted);
    font-size: 0.66rem;
    opacity: 0;
    animation: hud-in 1.2s ease 2.4s forwards;
  }

  .readout {
    position: absolute;
    right: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 3rem);
    color: var(--muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: hud-in 1.2s ease 2.4s forwards;
  }
  .readout span {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .mark,
    .readout {
      display: none;
    }
    .top {
      justify-content: center;
    }
    .hint {
      left: calc(var(--frame) + 1.6rem);
      right: auto;
      bottom: calc(var(--frame) + 0.2rem);
    }
    .identity {
      bottom: calc(var(--frame) + 2.2rem);
    }
  }

  @keyframes hud-in {
    to { opacity: 1; }
  }
  @keyframes hud-rise {
    to { opacity: 1; transform: none; }
  }
</style>
