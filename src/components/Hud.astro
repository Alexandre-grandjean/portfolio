---
// Cadre HUD : repères de coin, menu, identité, indications.
import site from '../data/site.json';

const links = [
  { id: 'parcours', label: 'Parcours' },
  { id: 'projets', label: 'Projets' },
  { id: 'cv', label: 'CV' },
];

const contacts = [
  {
    label: 'GitHub',
    href: site.github,
    external: true,
    icon: 'M12 .5a12 12 0 0 0-3.795 23.385c.6.105.825-.255.825-.57v-2.235c-3.345.72-4.05-1.425-4.05-1.425-.555-1.395-1.335-1.77-1.335-1.77-1.095-.75.09-.735.09-.735 1.215.09 1.845 1.245 1.845 1.245 1.065 1.845 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.475-1.335-5.475-5.925 0-1.305.465-2.385 1.245-3.225-.135-.3-.54-1.53.12-3.195 0 0 1.005-.315 3.3 1.23a11.52 11.52 0 0 1 6 0c2.295-1.545 3.3-1.23 3.3-1.23.66 1.665.255 2.895.12 3.195.78.84 1.245 1.92 1.245 3.225 0 4.605-2.805 5.61-5.49 5.91.435.375.825 1.11.825 2.235v3.315c0 .315.225.69.825.57A12.006 12.006 0 0 0 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    external: true,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z',
  },
  { label: 'Mail', href: site.email ? `mailto:${site.email}` : '', external: false, icon: null },
].filter((contact) => contact.href);
---

<div class="hud">
  <span class="corner tl" aria-hidden="true"></span>
  <span class="corner tr" aria-hidden="true"></span>
  <span class="corner bl" aria-hidden="true"></span>
  <span class="corner br" aria-hidden="true"></span>

  <header class="top">
    <nav class="contact-nav" aria-label="Me contacter">
      {contacts.map((contact) => (
        <a
          href={contact.href}
          target={contact.external ? '_blank' : undefined}
          rel={contact.external ? 'noopener noreferrer' : undefined}
          title={contact.label === 'Mail' ? site.email : undefined}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {contact.icon ? (
              <path fill="currentColor" d={contact.icon} />
            ) : (
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </g>
            )}
          </svg>
          <span>{contact.label}</span>
        </a>
      ))}
    </nav>
    <nav class="main-nav" aria-label="Navigation principale">
      {links.map((l) => <a href={`#${l.id}`} data-node={l.id}>{l.label}</a>)}
    </nav>
  </header>

  <div class="idle">
    <div class="identity">
      <p class="role">
        <span>{site.role}</span>
        <span>Étudiant en 2e année à Epitech (web@cadémie)</span>
      </p>
      <h1 class="name">{site.name}</h1>
    </div>

    <p class="hint" aria-hidden="true">Clique sur un astre pour voyager</p>
    <p class="readout" aria-hidden="true">
      X <span data-readout-x>0.00</span> &nbsp; Y <span data-readout-y>0.00</span>
    </p>
  </div>
</div>

<style>
  .hud {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hud::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(3, 4, 9, 0.92) 0%, rgba(3, 4, 9, 0.55) 45%, transparent 100%);
    z-index: -1;
    transition: opacity 0.8s ease;
  }

  :global(html[data-view]) .hud::before {
    opacity: 0;
  }

  .idle {
    position: absolute;
    inset: 0;
    transition: opacity 0.6s ease;
  }

  :global(html[data-view]) .idle {
    opacity: 0;
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--line);
    border-style: solid;
    border-width: 0;
    opacity: 0;
    animation: hud-in 1.2s ease 0.4s forwards;
  }
  .tl { top: var(--frame); left: var(--frame); border-top-width: 1px; border-left-width: 1px; }
  .tr { top: var(--frame); right: var(--frame); border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: var(--frame); left: var(--frame); border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: var(--frame); right: var(--frame); border-bottom-width: 1px; border-right-width: 1px; }

  .top {
    position: absolute;
    top: calc(var(--frame) + 0.9rem);
    left: calc(var(--frame) + 1.6rem);
    right: calc(var(--frame) + 1.6rem);
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    align-items: center;
    opacity: 0;
    animation: hud-in 1.2s ease 0.8s forwards;
  }

  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.2rem);
    pointer-events: auto;
  }

  .contact-nav {
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    letter-spacing: 0.08em;
  }

  .contact-nav a {
    gap: 0.5rem;
  }

  .contact-nav svg {
    flex: none;
    color: var(--accent);
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    touch-action: manipulation;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .identity {
    position: absolute;
    left: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 1.4rem);
    max-width: min(40rem, 70vw);
    opacity: 0;
    transform: translateY(14px);
    animation: hud-rise 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 1.2s forwards;
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
    letter-spacing: 0.07em;
    text-transform: none;
    font-size: 0.78rem;
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 6.4vw, 5.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text);
  }

  .hint {
    position: absolute;
    right: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 1.4rem);
    color: var(--muted);
    font-size: 0.66rem;
    opacity: 0;
    animation: hud-in 1.2s ease 2.4s forwards;
  }

  .readout {
    position: absolute;
    right: calc(var(--frame) + 1.6rem);
    bottom: calc(var(--frame) + 3rem);
    color: var(--muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: hud-in 1.2s ease 2.4s forwards;
  }
  .readout span {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .readout {
      display: none;
    }
    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.1rem;
      left: calc(var(--frame) + 0.8rem);
      right: calc(var(--frame) + 0.8rem);
    }
    .contact-nav {
      gap: 0.2rem 0.75rem;
    }
    .main-nav {
      gap: 1.5rem;
    }
    .hint {
      left: calc(var(--frame) + 1.6rem);
      right: auto;
      bottom: calc(var(--frame) + 0.2rem);
    }
    .identity {
      bottom: calc(var(--frame) + 2.2rem);
      max-width: calc(100vw - 2 * (var(--frame) + 1.6rem));
    }
  }

  @keyframes hud-in {
    to { opacity: 1; }
  }
  @keyframes hud-rise {
    to { opacity: 1; transform: none; }
  }
</style>
